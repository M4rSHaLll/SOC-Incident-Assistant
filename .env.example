APP_NAME="SOC Incident Assistant"
APP_ENV=development
LOG_LEVEL=INFO
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
RAG_MAX_CONTEXT_CHARS=12000
# Local development credentials only.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/soc_assistant
# Optional: enable integration tests only after creating and migrating this database.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/soc_assistant_test
